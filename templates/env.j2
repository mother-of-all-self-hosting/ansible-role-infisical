TZ={{ infisical_environment_variables_tz }}

{#
  See: https://help.infisical.ai/en/deploy/env
#}

PUBLIC_ORIGIN={{ infisical_scheme }}://{{ infisical_hostname }}
SECRET_KEY={{ infisical_environment_variables_secret_key }}
PORT={{ infisical_container_http_port }}
LOG_LEVEL={{ infisical_environment_variables_loglevel }}
NEXT_ENV_IMAGES_ALL_REMOTE={{ infisical_environment_variables_infisical_next_env_images_all_remote | to_json }}
BACKEND_SESSION_COOKIE_SECURE={{ infisical_environment_variables_backend_session_cookie_secure }}

POSTGRES_HOST={{ infisical_database_hostname }}
POSTGRES_PORT={{ infisical_database_port }}
POSTGRES_USER={{ infisical_database_username }}
POSTGRES_PASSWORD={{ infisical_database_password }}
POSTGRES_DB={{ infisical_database_name }}

REDIS_HOST={{ infisical_redis_hostname }}
REDIS_PORT={{ infisical_redis_port }}
REDIS_DB={{ infisical_redis_database }}

PRISMA_DATABASE_URL=postgresql://{{ infisical_database_username }}:{{ infisical_database_password }}@{{ infisical_database_hostname }}:{{ infisical_database_port }}/{{ infisical_database_name }}?sslmode={{ infisical_database_sslmode }}
BACKEND_CACHE_PROVIDER=redis
BACKEND_CACHE_REDIS_URI=redis://{{ infisical_redis_hostname }}:{{ infisical_redis_port }}/{{ infisical_redis_database }}

{{ infisical_environment_variables_additional_variables }}
