TZ={{ teable_environment_variables_tz }}

{#
  See: https://help.teable.ai/en/deploy/env
#}

PUBLIC_ORIGIN={{ teable_scheme }}://{{ teable_hostname }}
SECRET_KEY={{ teable_environment_variables_secret_key }}
PORT={{ teable_container_http_port }}
LOG_LEVEL={{ teable_environment_variables_loglevel }}
NEXT_ENV_IMAGES_ALL_REMOTE={{ teable_environment_variables_teable_next_env_images_all_remote | to_json }}
BACKEND_SESSION_COOKIE_SECURE={{ teable_environment_variables_backend_session_cookie_secure }}

POSTGRES_HOST={{ teable_database_hostname }}
POSTGRES_PORT={{ teable_database_port }}
POSTGRES_USER={{ teable_database_username }}
POSTGRES_PASSWORD={{ teable_database_password }}
POSTGRES_DB={{ teable_database_name }}

REDIS_HOST={{ teable_redis_hostname }}
REDIS_PORT={{ teable_redis_port }}
REDIS_DB={{ teable_redis_database }}

PRISMA_DATABASE_URL=postgresql://{{ teable_database_username }}:{{ teable_database_password }}@{{ teable_database_hostname }}:{{ teable_database_port }}/{{ teable_database_name }}?sslmode={{ teable_database_sslmode }}
BACKEND_CACHE_PROVIDER=redis
BACKEND_CACHE_REDIS_URI=redis://{{ teable_redis_hostname }}:{{ teable_redis_port }}/{{ teable_redis_database }}

{{ teable_environment_variables_additional_variables }}
