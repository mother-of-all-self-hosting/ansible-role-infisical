TZ={{ infisical_environment_variables_tz }}

{#
  See: https://infisical.com/docs/self-hosting/configuration/envars
#}

ENCRYPTION_KEY={{ infisical_environment_variables_encryption_key }}
AUTH_SECRET={{ infisical_environment_variables_auth_secret }}
DB_CONNECTION_URI={{ infisical_environment_variables_db_connection_uri }}
SITE_URL={{ infisical_environment_variables_site_url }}
TELEMETRY_ENABLED=false
REDIS_URL={{ infisical_environment_variables_redis_url }}

{% if infisical_environment_variables_smtp_host != '' %}
SMTP_HOST={{ infisical_environment_variables_smtp_host }}
SMTP_PORT={{ infisical_environment_variables_smtp_port }}
SMTP_USERNAME={{ infisical_environment_variables_smtp_username }}
SMTP_PASSWORD={{ infisical_environment_variables_smtp_password }}
SMTP_FROM_ADDRESS={{ infisical_environment_variables_smtp_from_address }}
SMTP_IGNORE_TLS={{ infisical_environment_variables_smtp_ignore_tls | to_json }}
SMTP_REQUIRE_TLS={{ infisical_environment_variables_smtp_require_tls | to_json }}
{% endif %}

{{ infisical_environment_variables_additional_variables }}
